{
  "name": "leap-app",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --workspace frontend dev",
    "backend-dev": "bun run --workspace backend dev",
    "frontend-dev": "bun run --workspace frontend dev",
    "install-all": "bun install",
    "start": "bun run --workspace frontend dev"
  }
}